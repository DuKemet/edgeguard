{
  "name": "@edgeguard/gateway",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "build": "tsup",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:unit": "vitest run test/unit",
    "test:integration": "vitest run test/integration"
  },
  "dependencies": {
    "@edgeguard/shared": "1.0.0",
    "bcryptjs": "2.4.3",
    "cors": "2.8.5",
    "dotenv": "16.5.0",
    "express": "4.22.3",
    "helmet": "8.1.0",
    "ioredis": "5.6.1",
    "jsonwebtoken": "9.0.2",
    "pino": "9.6.0",
    "prom-client": "15.1.3",
    "undici": "6.29.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "2.8.17",
    "@types/express": "4.17.22",
    "@types/jsonwebtoken": "9.0.9",
    "@types/node": "22.15.29",
    "@types/supertest": "6.0.3",
    "supertest": "7.1.1",
    "tsup": "8.5.0",
    "tsx": "4.19.4",
    "typescript": "5.8.3",
    "vitest": "3.2.4"
  }
}
