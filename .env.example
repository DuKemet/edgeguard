# Copy to .env and rotate every secret before any shared deployment.
# Generate hashes with: npm run hash-password -- "your-password"
# Generate random secrets with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"

NODE_ENV=production

# Gateway
PORT=8080
HOST=0.0.0.0
LOG_LEVEL=info
JWT_SECRET=7f2d4a9c1e8b6f3d5a0c2e7b9d4f1a6c8e3b5d7f0a2c4e6b8d1f3a5c7e9b0d2f
JWT_ISSUER=edgeguard
JWT_AUDIENCE=edgeguard-dashboard
TOKEN_TTL_SECONDS=3600
CLIENT_HASH_SECRET=3c6a9f2e5b8d1a4c7e0f3a6b9d2c5e8f1a4b7d0c3e6f9a2b5d8c1e4f7a0b3d6c

# Admin password: edgeguard-demo
ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH='$2a$10$bt9pWqvmSdIrzvi5mrzE0urskI8H2AmCRKU5KAlr1Bgq/PcFp3Ud6'

# Optional read-only dashboard account: edgeguard-viewer
VIEWER_USERNAME=viewer
VIEWER_PASSWORD_HASH='$2a$10$oMGoEt/Rx3GwS0KsPnd8keyxbv5JsvQAp1dOflc.gaAPGg6ope8lO'

# Optional bearer token for /metrics; leave empty for local Prometheus scraping.
METRICS_TOKEN=

# Upstream demo API
DEMO_PORT=4000
UPSTREAM_URL=http://demo-api:4000
UPSTREAM_ALLOWED_HOSTS=demo-api
ALLOW_PRIVATE_UPSTREAMS=true
UPSTREAM_TIMEOUT_MS=10000
MAX_RESPONSE_BYTES=5242880
MAX_REQUEST_BYTES=1048576
MAX_PATH_LENGTH=2048

# Redis
REDIS_URL=redis://redis:6379
REDIS_PREFIX=edgeguard
REDIS_REQUIRED=false
REDIS_CONNECT_TIMEOUT_MS=1500
REDIS_COMMAND_TIMEOUT_MS=750

# Browser origins allowed to call the admin API directly.
CORS_ORIGINS=http://localhost:8081,http://localhost:5173
TRUST_PROXY=1

# Grafana
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=edgeguard-admin
